# 複製成 .env 後，在等號後面填入（不要加空格）

# LINE Developers → Basic settings → Channel secret
LINE_CHANNEL_SECRET=
# LINE Developers → Messaging API → Channel access token（用來抓客人暱稱）
LINE_CHANNEL_ACCESS_TOKEN=

# 管理頁登入（在家用 localhost 開啟時使用；密碼一定要設）
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=

# Cloudflare Access（從 crm.beauty-keys.com 進來、通過 email 驗證的同仁，直接進入看板）
# Zero Trust → Access → Applications → 美之耀客服看板 → Overview 可查到這兩個值
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=

# 選填
FOLLOW_UP_DAYS=3
# macOS 的 5000 埠被 AirPlay 佔用，所以預設用 8765
PORT=8765

# ── Mac mini + Synology 備份（deploy/macos/backup.sh 使用）──
# Synology 共用資料夾掛載到 Mac 後的路徑
NAS_BACKUP_DIR=/Volumes/backup/line-crm
# 沒掛載時自動掛載用（帳密存在 Mac 鑰匙圈）
NAS_SMB_URL=smb://DiskStation.local/backup
BACKUP_KEEP_DAYS=30

# ── Ragic 串接（jobs.py 每分鐘同步；沒填就不串接）──
# API Key：填在 RAGIC_API_KEY，或放在檔案 RAGIC_KEY_FILE（預設 ~/.ragic_key，權限 600）
RAGIC_SERVER=ap10.ragic.com
RAGIC_ACCOUNT=
# 客服處理紀錄表（網址 /帳號/ 後面那段，例如 employee-zone/20）
RAGIC_LOG_SHEET=
# Ragic API 寫入只認欄位編號：設計模式點欄位，左側「欄位設定」下方的「欄位編號」
# 格式：欄位名稱=編號，逗號分隔，整串用雙引號包起來（LINE userId 有空格）；需要 12 個欄位（時間、處理人、處理人Email、動作、客人暱稱、
# 原狀態、新狀態、追蹤日、客人等待分鐘、說明、LINE userId、看板紀錄編號）
RAGIC_LOG_FIELD_IDS=
# 顧客基本資料表（綁定顧客、顯示消費摘要，只讀）
RAGIC_CUSTOMER_SHEET=
# 員工表（email → 姓名；只讀姓名、登入Gmail、在職狀態、角色）
RAGIC_STAFF_SHEET=

# ── Synology Chat 通知（沒填就不發）──
# Synology Chat → 頻道 → 整合 → 傳入的 Webhook → 複製網址
SYNOLOGY_CHAT_WEBHOOK=
# 通知裡的連結
PUBLIC_URL=https://crm.beauty-keys.com
# 術後關懷超過幾分鐘沒人處理就提醒；只在 ALERT_HOURS 時段內發（空白＝24 小時）
URGENT_ALERT_MINUTES=15
ALERT_HOURS=9-21
MORNING_REPORT_TIME=09:00
# 「我來回」認領多久後自動失效（分鐘）
CLAIM_MINUTES=30
