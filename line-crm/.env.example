# 複製成 .env 後，在等號後面填入（不要加空格）

# LINE Developers → Basic settings → Channel secret
LINE_CHANNEL_SECRET=
# LINE Developers → Messaging API → Channel access token（用來抓客人暱稱）
LINE_CHANNEL_ACCESS_TOKEN=

# 管理頁登入（密碼一定要設，沒設的話誰都進不去）
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=

# 選填
FOLLOW_UP_DAYS=3
# macOS 的 5000 埠被 AirPlay 佔用，所以預設用 8765
PORT=8765

# ── Mac mini + Synology 備份（deploy/macos/backup.sh 使用）──
# Synology 共用資料夾掛載到 Mac 後的路徑
NAS_BACKUP_DIR=/Volumes/backup/line-crm
# 沒掛載時自動掛載用（帳密存在 Mac 鑰匙圈）
NAS_SMB_URL=smb://DiskStation.local/backup
BACKUP_KEEP_DAYS=30
